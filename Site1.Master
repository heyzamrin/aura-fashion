<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site1.master.cs" Inherits="WebApplicationProject1.Site1" %>

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />

    <meta name="keywords" content="" />
    <meta name="description" content="" />
    <meta name="author" content="" />

    <link rel="shortcut icon" href="images/favicon.png" type="image/png" />

    <title>AURA - Fashion Store</title>

    <link rel="stylesheet" href="css/bootstrap.css" />
    <link rel="stylesheet" href="css/font-awesome.min.css" />
    <link rel="stylesheet" href="css/style.css" />
    <link rel="stylesheet" href="css/responsive.css" />

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>

    <style type="text/css">
        html, body {
            margin: 0;
            padding: 0;
            min-height: 100%;
        }

        body {
            background-color: #faf8f4;
            color: #333333;
            font-family: Arial, Helvetica, sans-serif;
            font-size: 14px;
            line-height: 1.5;
        }

        /* Header and navbar */
        .header_section {
            background-color: #ffffff;
            border-bottom: 1px solid #eee8dc;
            box-shadow: 0 1px 4px rgba(40, 30, 10, 0.04);
            position: relative;
            z-index: 1000;
            margin: 0;
            padding: 0;
        }

            .header_section .custom_nav-container {
                padding: 5px 0;
                min-height: 0;
            }

            .header_section .navbar-brand {
                margin: 0;
                padding: 0;
            }

                .header_section .navbar-brand img {
                    display: block;
                    width: 165px;
                    max-width: 100%;
                    height: auto;
                }

            .header_section .navbar-nav {
                align-items: center;
                gap: 3px;
                margin-left: auto;
            }

                .header_section .navbar-nav .nav-link {
                    color: #4b4438 !important;
                    font-size: 13px;
                    font-weight: 600;
                    padding: 6px 10px;
                    border-radius: 4px;
                    transition: color 0.2s ease, background-color 0.2s ease;
                }

                    .header_section .navbar-nav .nav-link:hover,
                    .header_section .navbar-nav .nav-link:focus {
                        color: #866528 !important;
                        background-color: #faf8f4;
                    }

            /* Login dropdown */
            .header_section .dropdown-menu {
                min-width: 190px;
                margin-top: 3px;
                padding: 5px;
                background-color: #ffffff;
                border: 1px solid #eee8dc;
                border-radius: 5px;
                box-shadow: 0 5px 15px rgba(40, 30, 10, 0.08);
            }

            .header_section .dropdown-item {
                padding: 7px 10px;
                color: #4b4438;
                font-size: 13px;
                border-radius: 3px;
            }

                .header_section .dropdown-item:hover,
                .header_section .dropdown-item:focus {
                    color: #866528;
                    background-color: #faf8f4;
                }

            /* Cart icon */
            .header_section .cart-link {
                display: flex;
                align-items: center;
                justify-content: center;
            }

                .header_section .cart-link svg {
                    display: block;
                    width: 18px;
                    height: 18px;
                    fill: #4b4438;
                    transition: fill 0.2s ease;
                }

                .header_section .cart-link:hover svg {
                    fill: #866528;
                }

            /* Mobile menu */
            .header_section .navbar-toggler {
                padding: 6px 8px;
                border: 1px solid #e5dccb;
                border-radius: 4px;
                outline: none;
                box-shadow: none;
            }

                .header_section .navbar-toggler span {
                    display: block;
                    width: 19px;
                    height: 2px;
                    position: relative;
                    background-color: #866528;
                }

                    .header_section .navbar-toggler span::before,
                    .header_section .navbar-toggler span::after {
                        content: "";
                        position: absolute;
                        left: 0;
                        width: 19px;
                        height: 2px;
                        background-color: #866528;
                    }

                    .header_section .navbar-toggler span::before {
                        top: -5px;
                    }

                    .header_section .navbar-toggler span::after {
                        top: 5px;
                    }

        /* Home page */
        .hero_area {
            background-color: #faf8f4;
            margin: 0;
            padding: 0;
        }

        /* Slider */
        .slider_section {
            position: relative;
            margin: 0;
            padding: 0;
            overflow: hidden;
            background-color: #e9e1d3;
        }

            .slider_section .carousel,
            .slider_section .carousel-inner,
            .slider_section .carousel-item {
                width: 100%;
            }

            .slider_section .carousel-item {
                position: relative;
                min-height: 500px;
                padding: 100px 0 80px;
                background: transparent;
            }

            .slider_section .slider_bg_box {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                z-index: 0;
            }

                .slider_section .slider_bg_box img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                    object-position: center;
                    display: block;
                }

            .slider_section .carousel-item .container {
                position: relative;
                z-index: 1;
            }

            .slider_section .detail-box {
                position: relative;
                z-index: 2;
                color: #ffffff;
                text-shadow: 0 1px 4px rgba(0, 0, 0, 0.6);
            }

                .slider_section .detail-box h1 {
                    color: #ffffff;
                    font-size: 48px;
                    font-weight: 700;
                }

                    .slider_section .detail-box h1 span {
                        color: #ffffff;
                    }

                .slider_section .detail-box p {
                    color: #ffffff;
                    font-size: 16px;
                    max-width: 500px;
                }

            .slider_section .btn-box .btn1 {
                display: inline-block;
                margin-top: 15px;
                padding: 12px 35px;
                color: #ffffff;
                background-color: #866528;
                border: 1px solid #866528;
                border-radius: 3px;
                text-decoration: none;
                text-shadow: none;
                transition: all 0.2s ease;
            }

                .slider_section .btn-box .btn1:hover {
                    color: #866528;
                    background-color: #ffffff;
                }

            .slider_section .carousel-indicators {
                z-index: 5;
                margin-bottom: 20px;
            }

                .slider_section .carousel-indicators li {
                    cursor: pointer;
                }

        /* Page content */
        #ContentPlaceHolder1 {
            margin: 0;
            padding: 0;
        }

        /* Responsive design */
        @media (max-width: 991px) {
            .header_section .custom_nav-container {
                padding: 5px 0;
            }

            .header_section .navbar-brand img {
                width: 150px;
            }

            .header_section .navbar-nav {
                align-items: stretch;
                gap: 0;
                padding-top: 4px;
                margin-left: 0;
            }

                .header_section .navbar-nav .nav-link {
                    padding: 7px 10px;
                }

            .header_section .dropdown-menu {
                margin-top: 0;
                box-shadow: none;
            }

            .slider_section .carousel-item {
                min-height: 430px;
                padding: 80px 0 70px;
            }

            .slider_section .detail-box h1 {
                font-size: 38px;
            }
        }

        @media (max-width: 480px) {
            .header_section .navbar-brand img {
                width: 135px;
            }

            .slider_section .carousel-item {
                min-height: 400px;
                padding: 65px 0;
            }

            .slider_section .detail-box h1 {
                font-size: 30px;
            }

            .slider_section .detail-box p {
                font-size: 14px;
            }
        }
    </style>
</head>

<body>
    <form id="form1" runat="server">

        <div class="hero_area">

            <!-- Header -->
            <header class="header_section">
                <div class="container">

                    <nav class="navbar navbar-expand-lg navbar-light custom_nav-container">

                        <!-- AURA logo -->
                        <a class="navbar-brand" href="HOME.aspx">
                            <img src="images/logol.png" alt="AURA Fashion Store" />
                        </a>

                        <!-- Mobile menu button -->
                        <button class="navbar-toggler"
                            type="button"
                            data-toggle="collapse"
                            data-target="#navbarSupportedContent"
                            aria-controls="navbarSupportedContent"
                            aria-expanded="false"
                            aria-label="Toggle navigation">
                            <span></span>
                        </button>

                        <!-- Navigation links -->
                        <div class="collapse navbar-collapse" id="navbarSupportedContent">
                            <ul class="navbar-nav">

                                <!-- Login dropdown -->
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle"
                                        href="#"
                                        id="navbarDropdown"
                                        role="button"
                                        data-toggle="dropdown"
                                        aria-haspopup="true"
                                        aria-expanded="false">Login
                                    </a>

                                    <div class="dropdown-menu" aria-labelledby="navbarDropdown">
                                        <a class="dropdown-item" href="Login.aspx">Login
                                        </a>

                                        <a class="dropdown-item" href="UserRegistration.aspx">User Registration
                                        </a>

                                        <a class="dropdown-item" href="AdminRegistration.aspx">Admin Registration
                                        </a>
                                    </div>
                                </li>

                                <!-- Products -->
                                <li class="nav-item">
                                    <a class="nav-link" href="UserHOME11.aspx">Products
                                    </a>
                                </li>

                                <!-- Cart -->
                                <li class="nav-item">
                                    <a class="nav-link cart-link"
                                        href="ViewCart1.aspx"
                                        title="Shopping Cart"
                                        aria-label="Shopping Cart">

                                        <svg xmlns="http://www.w3.org/2000/svg"
                                            viewBox="0 0 456.029 456.029"
                                            aria-hidden="true">
                                            <path d="M345.6,338.862c-29.184,0-53.248,23.552-53.248,53.248c0,29.184,23.552,53.248,53.248,53.248c29.184,0,53.248-23.552,53.248-53.248C398.336,362.926,374.784,338.862,345.6,338.862z" />
                                            <path d="M439.296,84.91c-1.024,0-2.56-0.512-4.096-0.512H112.64l-5.12-34.304C104.448,27.566,84.992,10.67,61.952,10.67H20.48C9.216,10.67,0,19.886,0,31.15c0,11.264,9.216,20.48,20.48,20.48h41.472c2.56,0,4.608,2.048,5.12,4.608l31.744,216.064c4.096,27.136,27.648,47.616,55.296,47.616h212.992c26.624,0,49.664-18.944,55.296-45.056l33.28-166.4C457.728,97.71,450.56,86.958,439.296,84.91z" />
                                            <path d="M215.04,389.55c-1.024-28.16-24.576-50.688-52.736-50.688c-29.696,1.536-52.224,26.112-51.2,55.296c1.024,28.16,24.064,50.688,52.224,50.688h1.024C193.536,443.31,216.576,418.734,215.04,389.55z" />
                                        </svg>

                                    </a>
                                </li>

                            </ul>
                        </div>

                    </nav>
                </div>
            </header>

            <!-- Home page slider -->
            <section class="slider_section">

                <div id="customCarousel1"
                    class="carousel slide"
                    data-ride="carousel"
                    data-interval="3000"
                    data-pause="false">

                    <div class="carousel-inner">

                        <!-- Slide 1 -->
                        <div class="carousel-item active">

                            <div class="slider_bg_box">
                                <img src="images/old-money-banner1.jpg"
                                    alt="Old money fashion collection" />
                            </div>

                            <div class="container">
                                <div class="row">
                                    <div class="col-md-7 col-lg-6">
                                        <div class="detail-box">
                                            <h1>
                                                <span>Sale 20% Off</span>
                                                <br />
                                                On Everything
                                            </h1>

                                            <p>
                                                Discover fashionable styles for every occasion.
                                                Find your favourites at AURA Fashion Store.
                                            </p>

                                            <div class="btn-box">
                                                <a href="UserHOME11.aspx" class="btn1">Shop Now
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Slide 2 -->
                        <div class="carousel-item">

                            <div class="slider_bg_box">
                                <img src="images/old-money-banner3.jpg"
                                    alt="Classic fashion collection" />
                            </div>

                            <div class="container">
                                <div class="row">
                                    <div class="col-md-7 col-lg-6">
                                        <div class="detail-box">
                                            <h1>
                                                <span>Timeless Style</span>
                                                <br />
                                                Discover AURA
                                            </h1>

                                            <p>
                                                Explore elegant everyday fashion and classic styles
                                                designed for every occasion.
                                            </p>

                                            <div class="btn-box">
                                                <a href="UserHOME11.aspx" class="btn1">Shop Now
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Slide 3 -->
                        <div class="carousel-item">

                            <div class="slider_bg_box">
                                <img src="images/old-money-banner2.jpg"
                                    alt="Elegant fashion collection" />
                            </div>

                            <div class="container">
                                <div class="row">
                                    <div class="col-md-7 col-lg-6">
                                        <div class="detail-box">
                                            <h1>
                                                <span>Classic Collection</span>
                                                <br />
                                                Made for You
                                            </h1>

                                            <p>
                                                Find your favourite looks at AURA Fashion Store
                                                and bring timeless fashion into your wardrobe.
                                            </p>

                                            <div class="btn-box">
                                                <a href="UserHOME11.aspx" class="btn1">Shop Now
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- Slider indicators -->
                    <div class="container">
                        <ol class="carousel-indicators">
                            <li data-target="#customCarousel1"
                                data-slide-to="0"
                                class="active"></li>

                            <li data-target="#customCarousel1"
                                data-slide-to="1"></li>

                            <li data-target="#customCarousel1"
                                data-slide-to="2"></li>
                        </ol>
                    </div>

                </div>
            </section>

            <!-- Page-specific content -->
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>

        </div>

    </form>

    <!-- JavaScript files -->
    <script src="js/jquery-3.4.1.min.js"></script>
    <script src="js/popper.min.js"></script>
    <script src="js/bootstrap.js"></script>
    <script src="js/custom.js"></script>

</body>
</html>
