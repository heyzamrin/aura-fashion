
<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site2.Master.cs" Inherits="WebApplicationProject1.Site2" %>

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Fashion Store</title>

    <link rel="stylesheet" href="css/bootstrap.css" />
    <link rel="stylesheet" href="css/font-awesome.min.css" />
    <link rel="stylesheet" href="css/style.css" />
    <link rel="stylesheet" href="css/responsive.css" />

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>

    <style type="text/css">
        html, body {
            margin: 0;
            padding: 0;
            min-height: 100%;
        }

        body {
            background-color: #faf8f4;
            color: #333333;
            font-family: Arial, Helvetica, sans-serif;
            font-size: 14px;
            line-height: 1.5;
        }

        /* Navbar */
        .header_section {
            background-color: #ffffff;
            border-bottom: 1px solid #eee8dc;
            box-shadow: 0 1px 4px rgba(40, 30, 10, 0.04);
            position: relative;
            z-index: 1000;
            margin: 0;
            padding: 0;
        }

        .header_section .custom_nav-container {
            padding: 5px 0;
            min-height: 0;
        }

        .header_section .navbar-brand {
            margin: 0;
            padding: 0;
        }

        .header_section .navbar-brand img {
            display: block;
            width: 165px;
            max-width: 100%;
            height: auto;
        }

        .header_section .navbar-nav {
            align-items: center;
            gap: 3px;
        }

        .header_section .navbar-nav .nav-link {
            color: #4b4438 !important;
            font-size: 13px;
            font-weight: 600;
            padding: 6px 10px;
            border-radius: 4px;
            transition: color 0.2s ease, background-color 0.2s ease;
        }

        .header_section .navbar-nav .nav-link:hover,
        .header_section .navbar-nav .nav-link:focus {
            color: #866528 !important;
            background-color: #faf8f4;
        }

        /* Login dropdown */
        .header_section .dropdown-menu {
            min-width: 190px;
            margin-top: 3px;
            padding: 5px;
            background-color: #ffffff;
            border: 1px solid #eee8dc;
            border-radius: 5px;
            box-shadow: 0 5px 15px rgba(40, 30, 10, 0.08);
        }

        .header_section .dropdown-item {
            padding: 7px 10px;
            color: #4b4438;
            font-size: 13px;
            border-radius: 3px;
        }

        .header_section .dropdown-item:hover,
        .header_section .dropdown-item:focus {
            color: #866528;
            background-color: #faf8f4;
        }

        /* Shopping cart */
        .header_section .cart-link {
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .header_section .cart-link svg {
            display: block;
            width: 18px;
            height: 18px;
            fill: #4b4438;
            transition: fill 0.2s ease;
        }

        .header_section .cart-link:hover svg {
            fill: #866528;
        }

        /* Mobile menu button */
        .header_section .navbar-toggler {
            padding: 6px 8px;
            border: 1px solid #e5dccb;
            border-radius: 4px;
            outline: none;
            box-shadow: none;
        }

        .header_section .navbar-toggler span {
            display: block;
            width: 19px;
            height: 2px;
            position: relative;
            background-color: #866528;
        }

        .header_section .navbar-toggler span::before,
        .header_section .navbar-toggler span::after {
            content: "";
            position: absolute;
            left: 0;
            width: 19px;
            height: 2px;
            background-color: #866528;
        }

        .header_section .navbar-toggler span::before {
            top: -5px;
        }

        .header_section .navbar-toggler span::after {
            top: 5px;
        }

        /* Remove extra space around the page content */
        .hero_area {
            background-color: #faf8f4;
            min-height: 0 !important;
            margin: 0 !important;
            padding: 0 !important;
        }

        #ContentPlaceHolder1 {
            display: block;
            margin: 0 !important;
            padding: 0 !important;
        }

        @media (max-width: 991px) {
            .header_section .custom_nav-container {
                padding: 5px 0;
            }

            .header_section .navbar-brand img {
                width: 150px;
            }

            .header_section .navbar-nav {
                align-items: stretch;
                gap: 0;
                padding-top: 4px;
            }

            .header_section .navbar-nav .nav-link {
                padding: 7px 10px;
            }

            .header_section .dropdown-menu {
                margin-top: 0;
                box-shadow: none;
            }
        }

        @media (max-width: 480px) {
            .header_section .navbar-brand img {
                width: 135px;
            }
        }
    </style>
</head>

<body>
    <form id="form1" runat="server">

        <div class="hero_area">

            <header class="header_section">
                <div class="container">

                    <nav class="navbar navbar-expand-lg navbar-light custom_nav-container">

                        <!-- Logo -->
                        <a class="navbar-brand" href="HOME.aspx">
                            <img src="images/logol.png" alt="Fashion Store" />
                        </a>

                        <!-- Mobile menu -->
                        <button class="navbar-toggler"
                            type="button"
                            data-toggle="collapse"
                            data-target="#navbarSupportedContent"
                            aria-controls="navbarSupportedContent"
                            aria-expanded="false"
                            aria-label="Toggle navigation">
                            <span></span>
                        </button>

                        <!-- Navigation links -->
                        <div class="collapse navbar-collapse"
                            id="navbarSupportedContent">

                            <ul class="navbar-nav ml-auto">

                                <li class="nav-item">
                                    <a class="nav-link" href="HOME.aspx">
                                        Home
                                    </a>
                                </li>

                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle"
                                        href="#"
                                        id="loginDropdown"
                                        role="button"
                                        data-toggle="dropdown"
                                        aria-haspopup="true"
                                        aria-expanded="false">
                                        Login
                                    </a>

                                    <div class="dropdown-menu"
                                        aria-labelledby="loginDropdown">

                                        <a class="dropdown-item" href="Login.aspx">
                                            User Login
                                        </a>

                                        <a class="dropdown-item" href="UserRegistration.aspx">
                                            User Registration
                                        </a>

                                        <a class="dropdown-item" href="AdminRegistration.aspx">
                                            Admin Registration
                                        </a>

                                    </div>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link" href="UserHOME11.aspx">
                                        Products
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link cart-link"
                                        href="ViewCart1.aspx"
                                        aria-label="Shopping cart"
                                        title="Shopping Cart">

                                        <svg xmlns="http://www.w3.org/2000/svg"
                                            viewBox="0 0 576 512"
                                            aria-hidden="true">
                                            <path d="M0 24C0 10.7 10.7 0 24 0H69.5c22 0 41.2 15.5 46.1 36.9L122.8 64H552c15.1 0 26.5 13.8 23.7 28.7l-40 208c-2.2 11.5-12.3 19.8-24 19.8H171.4l4.8 24H488c13.3 0 24 10.7 24 24s-10.7 24-24 24H156.5c-11.5 0-21.4-8.1-23.7-19.3L65.1 48H24C10.7 48 0 37.3 0 24zM176 464a24 24 0 1 1-48 0 24 24 0 0 1 48 0zm288 0a24 24 0 1 1-48 0 24 24 0 0 1 48 0z" />
                                        </svg>

                                    </a>
                                </li>

                            </ul>
                        </div>

                    </nav>
                </div>
            </header>

        </div>

        <!-- Page-specific content -->
        <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
        </asp:ContentPlaceHolder>

    </form>

    <script src="js/jquery-3.4.1.min.js"></script>
    <script src="js/popper.min.js"></script>
    <script src="js/bootstrap.js"></script>
    <script src="js/custom.js"></script>

</body>
</html>
